tag_plot <- function(p, tag) {
p + labs(tag = tag) +
theme(
plot.tag = element_text(face = "bold", size = 13, family = "serif"),
plot.tag.position = c(0, 1)
)
}
p_adj_list <- Map(tag_plot, p_adj_list, c("A", "E", "I"))
p_land_list <- Map(tag_plot, p_land_list, c("B", "F", "J"))
p_year_list <- Map(tag_plot, p_year_list, c("C", "G", "K"))
p_spatial_list <- Map(tag_plot, p_spatial_list, c("D", "H", "L"))
fig_region <-
wrap_plots(p_adj_list, nrow = 1) /
wrap_plots(p_land_list, nrow = 1) /
wrap_plots(p_year_list, nrow = 1) /
wrap_plots(p_spatial_list, nrow = 1,  widths = c(1, 1, 1)) +
plot_layout(heights = c(1, 1, 0.9, 1.20)) +
plot_annotation(
title = region_name,
theme = theme(
plot.title = element_text(
size = 16,
face = "bold",
family = "serif",
hjust = 0.5
)
)
) &
theme(
text = element_text(face = "bold", family = "serif"),
plot.tag = element_text(face = "bold", size = 13)
)
fig_region
out_fig_dir <- file.path("fig")
dir.create(out_fig_dir, showWarnings = FALSE, recursive = TRUE)
ggsave(
file.path(out_fig_dir, paste0("painels/figure_ensemble_", region_name, "_all_variables.png")),
fig_region, width = 10, height = 12, dpi = 600, bg = "white")
ggsave(file.path(out_fig_dir, paste0("painels/figure_ensemble_", region_name, "_all_variables.pdf")),
plot = fig_region, width = 10, height = 12, bg = "white")
safe_quantile <- function(x, p) {
if (all(is.na(x))) return(NA_real_)
as.numeric(quantile(x, p, na.rm = TRUE))
}
read_all_files <- function(path, pattern) {
files <- list.files(path, pattern = pattern, full.names = TRUE)
if (length(files) == 0) return(data.table())
rbindlist(lapply(files, fread), fill = TRUE)
}
get_out_dir <- function(response_var, region_name) {
paste0("spamm_ensemble_", tolower(response_var), "_diagnostics_", region_name)
}
region_name <- "SBA"
response_vars <- c("Prec", "Evapo", "Temp")
response_labels <- c(
Prec  = "Precipitation",
Evapo = "Evapotranspiration",
Temp  = "Land surface temperature"
)
response_units <- c(
Prec  = "mm",
Evapo = "mm",
Temp  = "°C"
)
color_year <- c(
Prec  = "midnightblue",
Evapo = "#02401B",
Temp  = "#7F3B08"
)
load_diag_results <- function(response_var, region_name) {
out_dir <- get_out_dir(response_var, region_name)
diagnostics_ensemble <- read_all_files(
file.path(out_dir, "diagnostics"),
"^diagnostics_run_.*\\.csv$"
)
metrics_ensemble <- read_all_files(
file.path(out_dir, "metrics"),
"^metrics_run_.*\\.csv$"
)
if (nrow(diagnostics_ensemble) == 0) {
stop("No diagnostics files found for ", response_var, " in ", out_dir)
}
if (nrow(metrics_ensemble) == 0) {
stop("No metrics files found for ", response_var, " in ", out_dir)
}
diagnostics_ensemble <- diagnostics_ensemble %>%
mutate(
response = response_var,
variable_label = response_labels[[response_var]]
)
metrics_ensemble <- metrics_ensemble %>%
mutate(
response = response_var,
variable_label = response_labels[[response_var]]
)
list(
diagnostics = diagnostics_ensemble,
metrics = metrics_ensemble
)
}
theme_diag <- function() {
theme_bw(base_size = 11) +
theme(
text = element_text(face = "bold", family = "serif"),
plot.title = element_text(hjust = 0.5, size = 12),
axis.title = element_text(size = 11),
axis.text = element_text(size = 10, color = "black"),
strip.text = element_blank(),
strip.background = element_blank(),
panel.grid.minor = element_blank(),
aspect.ratio = 1,
plot.margin = margin(t = 3, r = 5, b = 4, l = 5)
)
}
sample_diag <- function(dat, n_max = 30000) {
set.seed(123)
as.data.table(dat)[
,
.SD[sample(.N, min(.N, n_max))],
by = response
]
}
make_p_resid <- function(dat, response_var, first_col = FALSE) {
unit <- response_units[[response_var]]
label <- response_labels[[response_var]]
col <- color_year[[response_var]]
ggplot(dat, aes(x = fitted, y = residual)) +
geom_point(alpha = 0.14, size = 0.22, color = col) +
geom_smooth(method = "loess", se = FALSE, color = "black", linewidth = 0.55) +
geom_hline(yintercept = 0, linetype = "dashed", color = "grey35", linewidth = 0.35) +
labs(
title = label,
x = paste0("Fitted (", unit, ")"),
y = ifelse(first_col, paste0("Residuals\n(", unit, ")"), paste0("\n(", unit, ")"))
) +
theme_diag()
}
make_p_qq <- function(dat, response_var, first_col = FALSE) {
unit <- response_units[[response_var]]
col <- color_year[[response_var]]
ggplot(dat, aes(sample = residual)) +
stat_qq(size = 0.25, alpha = 0.25, color = col) +
stat_qq_line(linewidth = 0.55, color = "black") +
labs(
x = "Theoretical quantiles",
y = ifelse( first_col,  paste0("Sample quantiles\n(", unit, ")"),  paste0("\n(", unit, ")"))) +
theme_diag()
}
make_p_obs_pred <- function(dat, metrics, response_var, first_col = FALSE) {
unit <- response_units[[response_var]]
col <- color_year[[response_var]]
ccc_med <- median(metrics$CCC, na.rm = TRUE)
r2_med <- median(metrics$R2, na.rm = TRUE)
label_txt <- paste0(
"CCC = ", round(ccc_med, 2),
"\nR² = ", round(r2_med, 2)
)
ggplot(dat, aes(x = observed, y = fitted)) +
geom_point(alpha = 0.18, size = 0.25, color = col) +
geom_smooth(method = "lm", se = FALSE, color = "black", linewidth = 0.55) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "grey35", linewidth = 0.35) +
annotate(
"text",
x = -Inf, y = Inf,
label = label_txt,
hjust = -0.1, vjust = 1.5,
size = 3.5,
family = "serif",
fontface = "bold"
) +
labs(
x = paste0("Observed (", unit, ")"),
y = ifelse(first_col, paste0("Predicted\n(", unit, ")"), paste0("\n(", unit, ")"))
) +
theme_diag()
}
make_p_accuracy <- function(metrics, response_var, first_col = FALSE) {
col <- color_year[[response_var]]
dat <- metrics %>%
select(region, run, CCC, R2) %>%
pivot_longer(
cols = c(CCC, R2),
names_to = "metric",
values_to = "value"
) %>%
mutate(
metric = factor(metric, levels = c("CCC", "R2"), labels = c("CCC", "R²"))
)
ggplot(dat, aes(x = metric, y = value)) +
geom_boxplot(
width = 0.45,
outlier.shape = NA,
linewidth = 0.45,
fill = "white",
color = col
) +
geom_jitter(
width = 0.08,
alpha = 0.65,
size = 1.2,
color = col
) +
stat_summary(
fun = median,
geom = "point",
shape = 23,
size = 2.4,
fill = "white",
color = "black"
) +
coord_cartesian(ylim = c(0, 1)) +
scale_y_continuous(breaks = seq(0, 1, by = 0.25)) +
labs(
x = NULL,
y = ifelse(first_col, "Agreement /\nexplained variance", "")
) +
theme_diag()
}
make_p_error <- function(metrics, response_var, first_col = FALSE) {
unit <- response_units[[response_var]]
col <- color_year[[response_var]]
dat <- metrics %>%
select(region, run, RMSE, MAE) %>%
pivot_longer(
cols = c(RMSE, MAE),
names_to = "metric",
values_to = "value"
) %>%
mutate(
metric = factor(metric, levels = c("RMSE", "MAE"))
)
ggplot(dat, aes(x = metric, y = value)) +
geom_boxplot(
width = 0.45,
outlier.shape = NA,
linewidth = 0.45,
fill = "white",
color = col
) +
geom_jitter(
width = 0.08,
alpha = 0.65,
size = 1.2,
color = col
) +
stat_summary(
fun = median,
geom = "point",
shape = 23,
size = 2.4,
fill = "white",
color = "black"
) +
labs(
x = NULL,
y = ifelse(first_col, paste0("Error metrics\n(", unit, ")"), paste0("\n(", unit, ")"))
) +
theme_diag()
}
diag_results <- lapply(response_vars, load_diag_results, region_name = region_name)
names(diag_results) <- response_vars
diag_sampled <- lapply(diag_results, function(x) {
sample_diag(x$diagnostics, n_max = 30000)
})
metrics_list <- lapply(diag_results, function(x) {
x$metrics
})
first_col_flags <- c(TRUE, FALSE, FALSE)
p_resid_list <- Map(
function(v, fc) {
make_p_resid(
diag_sampled[[v]],
response_var = v,
first_col = fc
)
},
response_vars,
first_col_flags
)
p_qq_list <- Map(
function(v, fc) {
make_p_qq(
diag_sampled[[v]],
response_var = v,
first_col = fc
)
},
response_vars,
first_col_flags
)
p_obs_list <- Map(
function(v, fc) {
make_p_obs_pred(
diag_sampled[[v]],
metrics = metrics_list[[v]],
response_var = v,
first_col = fc
)
},
response_vars,
first_col_flags
)
p_acc_list <- Map(
function(v, fc) {
make_p_accuracy(
metrics_list[[v]],
response_var = v,
first_col = fc
)
},
response_vars,
first_col_flags
)
p_err_list <- Map(
function(v, fc) {
make_p_error(
metrics_list[[v]],
response_var = v,
first_col = fc
)
},
response_vars,
first_col_flags
)
tag_plot <- function(p, tag) {
p + labs(tag = tag) +
theme(
plot.tag = element_text(face = "bold", size = 13, family = "serif"),
plot.tag.position = c(0, 1)
)
}
p_resid_list <- Map(tag_plot, p_resid_list, c("A", "E", "I"))
p_qq_list    <- Map(tag_plot, p_qq_list,    c("B", "F", "J"))
p_obs_list   <- Map(tag_plot, p_obs_list,   c("C", "G", "K"))
p_err_list   <- Map(tag_plot, p_err_list,   c("D", "H", "L"))
fig_diag_region <-
wrap_plots(
c(
p_resid_list,
p_qq_list,
p_obs_list,
p_err_list
),
ncol = 3,
byrow = TRUE
) +
plot_layout(
widths = c(1, 1, 1),
heights = c(1, 1, 1, 1)
) +
plot_annotation(
title = paste0(region_name),
theme = theme(
plot.title = element_text(
size = 16,
face = "bold",
family = "serif",
hjust = 0.5
)
)
) &
theme(
text = element_text(face = "bold", family = "serif"),
plot.tag = element_text(face = "bold", size = 13)
)
fig_diag_region
ggsave(
file.path(out_fig_dir, paste0("painels/figure_diagnostics_", region_name, "_all_variables.png")),
fig_diag_region, width = 10, height = 11.5, dpi = 600, bg = "white")
ggsave(file.path(out_fig_dir, paste0("painels/figure_diagnostics_", region_name, "_all_variables.pdf")),
plot = fig_diag_region, width = 10, height = 11.5, bg = "white")
